  <!-- Left Jaw Slide Joint -->
  <joint name="left_jaw_slide_joint" type="prismatic">
    <parent link="link_6_gripper_base" />
    <child link="link_6_left_jaw" />
    <origin xyz="0 -0.046232 3.8e-05" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="0.0255" effort="50.0" velocity="0.042"  />
    <mimic joint="right_jaw_slide_joint" multiplier="1" offset="0" />
    <dynamics damping="0.01" friction="0" />
  </joint>

  <!-- Left Jaw Link -->
  <link name="link_6_left_jaw">
    <inertial>
      <origin xyz="-0.00995268442 -0.0113778227 -0.00071474072" rpy="0 0 0" />
      <mass value="0.0429566" />
      <inertia ixx="8.791444e-06" ixy="-7.462964e-07" ixz="-2.699997e-07" iyy="5.542263e-06" iyz="-5.317703e-07" izz="8.695677e-06" />
