      <origin xyz="1.4875552e-05 -0.0392045753 0.000149826622" rpy="0 0 0" />
      <mass value="0.0304143" />
      <inertia ixx="3.453790e-06" ixy="6.237030e-09" ixz="-1.323944e-09" iyy="3.877610e-05" iyz="-3.051585e-08" izz="3.645799e-05" />
