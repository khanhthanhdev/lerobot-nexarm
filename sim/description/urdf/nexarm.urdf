  <joint name="joint_5_to_gripper_fixed" type="fixed">
    <parent link="link_5" />
    <child link="link_6_gripper_base" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- Gripper Base -->
  <link name="link_6_gripper_base">
    <inertial>
      <origin xyz="-4.32065537e-07 -0.0392947518 0.000175914126" rpy="0 0 0" />
      <mass value="0.0304143" />
      <inertia ixx="3.453789e-06" ixy="-7.254020e-12" ixz="-9.222489e-15" iyy="3.877610e-05" iyz="-3.051565e-08" izz="3.645799e-05" />
