<?xml version='1.0' encoding='utf-8'?>
<robot name="nexarm">
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0" />
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0" />
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="1.02799772e-05 0.000536543393 0.0187781864" rpy="0 0 0" />
      <mass value="0.307643" />
      <inertia ixx="5.498090e-04" ixy="1.626228e-07" ixz="-6.868540e-09" iyy="5.570952e-04" iyz="7.496669e-06" izz="7.322669e-04" />
    </inertial>
    <visual>
      <origin xyz="-0.539369 -0.0639728 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../../assets/meshes/visual/base_link.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision name="base_link_collision_0">
      <origin xyz="0 0 0.03" rpy="0 0 0" />
      <geometry>
        <box size="0.11135 0.11135 0.070006" />
      </geometry>
    </collision>
  </link>

  <!-- Joint 1: Base to Link 1 (Shoulder Pan) -->
  <joint name="joint_1_base_to_link_1" type="revolute">
    <parent link="base_link" />
    <child link="link_1" />
    <origin xyz="0 0 0.049" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <limit lower="-2.35619" upper="2.35619" effort="2.94" velocity="5.51"  />
    <dynamics damping="0.08" friction="0.04" />
  </joint>

  <!-- Link 1 -->
  <link name="link_1">
    <inertial>
      <origin xyz="2.41148736e-05 -0.000456853793 0.0227804084" rpy="0 0 0" />
      <mass value="0.28384" />
      <inertia ixx="2.032788e-04" ixy="6.009257e-07" ixz="2.280297e-07" iyy="2.487346e-04" iyz="1.981360e-06" izz="2.474501e-04" />
    </inertial>
    <visual>
      <origin xyz="-0.539369 -0.0639728 -0.049" rpy="0 0 0" />
      <geometry>
        <mesh filename="../../assets/meshes/visual/link_1.stl" scale="0.001 0.001 0.001" />
      </geometry>
      <material name="dark_grey" />
    </visual>
    <collision name="link_1_collision_0">
      <origin xyz="0 0 0.031028" rpy="0 0 0" />
      <geometry>
        <box size="0.094976 0.09498 0.073056" />
      </geometry>
    </collision>
  </link>

  <!-- Joint 2: Link 1 to Link 2 (Shoulder Lift) -->
  <joint name="joint_2_link_1_to_link_2" type="revolute">
    <parent link="link_1" />
    <child link="link_2" />
    <origin xyz="0.0351 0 0.057445" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit lower="-2.0944" upper="2.0944" effort="6.37" velocity="5.51"  />
    <dynamics damping="0.15" friction="0.08" />
  </joint>

  <!-- Link 2 -->
  <link name="link_2">
    <inertial>
      <origin xyz="-0.035099976 0.0804480723 0.0817056804" rpy="0 0 0" />
      <mass value="0.192568" />
