      </geometry>
    </collision>
  </link>

  <!-- Joint 4: Link 3 to Link 4 (Wrist Flex) -->
  <joint name="joint_4_link_3_to_link_4" type="revolute">
    <parent link="link_3" />
    <child link="link_4" />
    <origin xyz="-0.00032 -0.131414 -0.061278" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-1.74533" upper="1.74533" effort="2.94" velocity="5.51"  />
    <dynamics damping="0.08" friction="0.04" />
  </joint>

  <!-- Link 4 -->
  <link name="link_4">
    <inertial>
      <origin xyz="0.0201098869 -0.0272834639 -0.00531566762" rpy="0 0 0" />
      <mass value="0.0554609" />
      <inertia ixx="1.863344e-05" ixy="-1.259432e-07" ixz="5.271931e-09" iyy="1.669997e-05" iyz="1.604202e-06" izz="2.290469e-05" />
