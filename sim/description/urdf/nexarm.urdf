  </link>

  <!-- Tool centre point: the MJCF gripper_frame site (sim/isaac_lab/build_isaac_assets.py) -->
  <link name="gripper_frame" />
  <joint name="gripper_frame_joint" type="fixed">
    <parent link="link_6_gripper_base" />
    <child link="gripper_frame" />
    <origin xyz="-0.000369 -0.108286 -0.000364" rpy="0 0 0" />
  </joint>

  <!-- Gripper Pinion Gear Joint -->
  <joint name="gripper_pinion_joint" type="revolute">
    <parent link="link_6_gripper_base" />
    <child link="link_6_pinion_gear" />
    <origin xyz="0 -0.03994 3.5e-05" rpy="0 0 0" />
    <axis xyz="0 -0.000548 -1" />
    <limit lower="-3.14159" upper="3.14159" effort="1.18" velocity="5.24"  />
    <dynamics damping="0.08" friction="0.04" />
  </joint>

  <!-- Gripper Pinion Gear Link -->
  <link name="link_6_pinion_gear">
    <inertial>
      <origin xyz="1.47125783e-05 0.00206091688 -4.78289993e-05" rpy="0 0 0" />
