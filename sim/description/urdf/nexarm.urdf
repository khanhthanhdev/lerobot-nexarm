  <joint name="joint_5_link_4_to_link_5" type="revolute">
    <parent link="link_4" />
    <child link="link_5" />
    <origin xyz="0.02025 -0.047234 4.3e-05" rpy="0 0 0" />
    <axis xyz="0 -1 0.000548" />
    <limit lower="-3.14159" upper="3.14159" effort="1.18" velocity="5.24"  />
    <dynamics damping="0.04" friction="0.02" />
  </joint>

  <!-- Link 5 -->
  <link name="link_5">
    <inertial>
      <origin xyz="-5.7677464e-05 -0.0194454844 -0.005211788" rpy="0 0 0" />
      <mass value="0.0449343" />
      <inertia ixx="9.635606e-06" ixy="-4.247220e-09" ixz="3.251408e-08" iyy="9.110348e-06" iyz="6.083407e-07" izz="9.762553e-06" />
    </inertial>
    <visual>
      <origin xyz="-0.539369 0.165057 -0.33133" rpy="0 0 0" />
      <geometry>
        <mesh filename="../../assets/meshes/visual/link_5.stl" scale="0.001 0.001 0.001" />
