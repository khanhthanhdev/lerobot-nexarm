      <inertia ixx="7.668498e-08" ixy="-1.034726e-17" ixz="1.078471e-16" iyy="1.431190e-07" iyz="-3.184284e-12" izz="7.668498e-08" />
    </inertial>
    <visual>
      <origin xyz="-0.539369 0.021654 -0.230436" rpy="0 0 0" />
