    <collision name="link_1_collision_0">
      <origin xyz="0 0 0.031028" rpy="0 0 0" />
      <geometry>
        <box size="0.094976 0.09498 0.073056" />
      </geometry>
    </collision>
  </link>

  <!-- Joint 2: Link 1 to Link 2 (Shoulder Lift) -->
  <joint name="joint_2_link_1_to_link_2" type="revolute">
    <parent link="link_1" />
    <child link="link_2" />
    <origin xyz="0.0351 0 0.057445" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit lower="-2.0944" upper="2.0944" effort="6.37" velocity="5.51"  />
    <dynamics damping="0.15" friction="0.08" />
  </joint>

  <!-- Link 2 -->
  <link name="link_2">
    <inertial>
      <origin xyz="-0.035099976 -0.000889224108 0.114660065" rpy="0 0 0" />
      <mass value="0.192568" />
