      <geometry>
        <box size="0.07856 0.066306 0.024724" />
      </geometry>
    </collision>
  </link>

  <!-- Joint 3: Link 2 to Link 3 (Elbow Flex) -->
  <joint name="joint_3_link_2_to_link_3" type="revolute">
    <parent link="link_2" />
    <child link="link_3" />
    <origin xyz="-0.05503 0.132961 0.185239" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-2.35619" upper="2.35619" effort="2.94" velocity="5.51"  />
    <dynamics damping="0.08" friction="0.04" />
  </joint>

  <!-- Link 3 -->
  <link name="link_3">
    <inertial>
      <origin xyz="0.0188380115 -0.0636707702 -0.0296131681" rpy="0 0 0" />
      <mass value="0.196103" />
      <inertia ixx="5.809189e-04" ixy="6.254772e-07" ixz="2.302946e-07" iyy="1.269977e-04" iyz="2.142776e-04" izz="4.868017e-04" />
