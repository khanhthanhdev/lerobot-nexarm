  <joint name="joint_5_link_4_to_link_5" type="revolute">
    <parent link="link_4" />
    <child link="link_5" />
    <origin xyz="0.02025 -0.047234 0.000017" rpy="0 0 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-3.14159" upper="3.14159" effort="1.18" velocity="5.24"  />
    <dynamics damping="0.04" friction="0.02" />
  </joint>

  <!-- Link 5 -->
  <link name="link_5">
    <inertial>
      <origin xyz="-6.92754246e-05 -0.0195356484 -0.00518570298" rpy="0 0 0" />
      <mass value="0.0449343" />
      <inertia ixx="9.635610e-06" ixy="-4.178849e-09" ixz="3.262676e-08" iyy="9.110346e-06" iyz="6.083347e-07" izz="9.762550e-06" />
    </inertial>
    <visual>
      <origin xyz="-0.539369 -0.018286 -0.230423" rpy="0 0 0" />
