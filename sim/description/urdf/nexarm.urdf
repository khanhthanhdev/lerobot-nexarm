      <geometry>
        <box size="0.082686 0.044746 0.058278" />
      </geometry>
    </collision>
  </link>

  <!-- Joint 3: Link 2 to Link 3 (Elbow Flex) -->
  <joint name="joint_3_link_2_to_link_3" type="revolute">
    <parent link="link_2" />
    <child link="link_3" />
    <origin xyz="-0.05503 -0.036797 0.225029" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-2.35619" upper="2.35619" effort="2.94" velocity="5.51"  />
    <dynamics damping="0.08" friction="0.04" />
  </joint>

  <!-- Link 3 -->
  <link name="link_3">
    <inertial>
      <origin xyz="0.0188380115 -0.0701267469 1.12946518e-05" rpy="0 0 0" />
      <mass value="0.196103" />
      <inertia ixx="5.809189e-04" ixy="6.642977e-07" ixz="-5.446095e-08" iyy="2.711611e-05" iyz="8.987228e-07" izz="5.866832e-04" />
