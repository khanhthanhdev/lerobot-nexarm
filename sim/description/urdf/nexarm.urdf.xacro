<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nexarm">

  <xacro:macro name="nexarm" params="prefix:='' parent:='' *origin attach_cam_mount:=true mesh_dir:='package://nexarm_description/meshes/visual'">
    <!-- Base attachment if parent link is provided -->
    <xacro:if value="${parent != ''}">
      <joint name="${prefix}base_mount_joint" type="fixed">
        <parent link="${parent}"/>
        <child link="${prefix}base_link"/>
        <xacro:insert_block name="origin"/>
      </joint>
    </xacro:if>

    <!-- Materials -->
    <material name="${prefix}dark_grey">
      <color rgba="0.2 0.2 0.2 1.0"/>
    </material>
    <material name="${prefix}black">
      <color rgba="0.1 0.1 0.1 1.0"/>
    </material>
    <material name="${prefix}metal_accent">
      <color rgba="0.6 0.6 0.6 1.0"/>
    </material>

    <!-- Base Link -->
    <link name="${prefix}base_link">
      <inertial>
        <origin xyz="1.15052e-05 -0.000135185 0.0185734" rpy="0 0 0"/>
        <mass value="0.337502"/>
        <inertia ixx="5.997589e-04" ixy="-1.894866e-07" ixz="-7.704759e-10" iyy="6.180225e-04" iyz="-5.101484e-06" izz="8.033066e-04"/>
      </inertial>
      <visual>
        <origin xyz="-0.539369 -0.0639728 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/base_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}dark_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.539369 -0.0639728 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/base_link.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint 1: Base to Link 1 (Shoulder Pan) -->
    <joint name="${prefix}joint_1_base_to_link_1" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <origin xyz="0 0 0.049" rpy="0 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-2.35619" upper="2.35619" effort="5.0" velocity="3.14"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>

    <!-- Link 1 -->
    <link name="${prefix}link_1">
      <inertial>
        <origin xyz="9.61443e-09 -0.000461208 0.0224849" rpy="0 0 0"/>
        <mass value="0.313113"/>
        <inertia ixx="2.229416e-04" ixy="-6.650422e-07" ixz="-3.057907e-10" iyy="2.733856e-04" iyz="-2.159874e-06" izz="2.750649e-04"/>
      </inertial>
      <visual>
        <origin xyz="-0.539369 -0.0639728 -0.049" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}dark_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.539369 -0.0639728 -0.049" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint 2: Link 1 to Link 2 (Shoulder Lift) -->
    <joint name="${prefix}joint_2_link_1_to_link_2" type="revolute">
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <origin xyz="0.0351 0 0.057445" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="-2.0944" upper="2.0944" effort="5.0" velocity="3.14"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>

    <!-- Link 2 -->
    <link name="${prefix}link_2">
      <inertial>
        <origin xyz="-0.03428 0.0804481 0.0817056" rpy="0 0 0"/>
        <mass value="0.214299"/>
        <inertia ixx="9.579524e-04" ixy="-2.739469e-12" ixz="-3.102562e-12" iyy="5.506644e-04" iyz="-4.631510e-04" izz="5.079891e-04"/>
      </inertial>
      <visual>
        <origin xyz="-0.574469 -0.0639728 -0.106445" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}dark_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.574469 -0.0639728 -0.106445" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint 3: Link 2 to Link 3 (Elbow Flex) -->
    <joint name="${prefix}joint_3_link_2_to_link_3" type="revolute">
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <origin xyz="-0.05503 0.132961 0.185239" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-2.35619" upper="2.35619" effort="5.0" velocity="3.14"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>

    <!-- Link 3 -->
    <link name="${prefix}link_3">
      <inertial>
        <origin xyz="0.018748 -0.063648 -0.029599" rpy="0 0 0"/>
        <mass value="0.215718"/>
        <inertia ixx="6.377538e-04" ixy="-7.337792e-07" ixz="-2.804414e-07" iyy="1.395571e-04" iyz="-2.351785e-04" izz="5.344644e-04"/>
      </inertial>
      <visual>
        <origin xyz="-0.519439 -0.196934 -0.291684" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_3.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}dark_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.519439 -0.196934 -0.291684" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_3.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint 4: Link 3 to Link 4 (Wrist Flex) -->
    <joint name="${prefix}joint_4_link_3_to_link_4" type="revolute">
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <origin xyz="-0.00032 -0.131414 -0.061278" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.74533" upper="1.74533" effort="5.0" velocity="3.14"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>

    <!-- Link 4 -->
    <link name="${prefix}link_4">
      <inertial>
        <origin xyz="0.020099 -0.024239 -0.004596" rpy="0 0 0"/>
        <mass value="0.049369"/>
        <inertia ixx="1.645108e-05" ixy="1.309816e-07" ixz="-7.923898e-09" iyy="1.627690e-05" iyz="-1.241160e-06" izz="2.185268e-05"/>
      </inertial>
      <visual>
        <origin xyz="-0.519119 -0.06552 -0.230406" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}dark_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.519119 -0.06552 -0.230406" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Joint 5: Link 4 to Link 5 (Wrist Roll) -->
    <joint name="${prefix}joint_5_link_4_to_link_5" type="revolute">
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <origin xyz="0.02025 -0.047234 0.000017" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-3.14159" upper="3.14159" effort="5.0" velocity="3.14"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>

    <!-- Link 5 -->
    <link name="${prefix}link_5">
      <inertial>
        <origin xyz="-0.00006 -0.016152 -0.004198" rpy="0 0 0"/>
        <mass value="0.037654"/>
        <inertia ixx="6.944998e-06" ixy="8.565464e-09" ixz="-3.233923e-08" iyy="7.802159e-06" iyz="-1.639356e-07" izz="7.760757e-06"/>
      </inertial>
      <visual>
        <origin xyz="-0.539369 -0.018286 -0.230423" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}dark_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.539369 -0.018286 -0.230423" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Gripper Base -->
    <joint name="${prefix}joint_5_to_gripper_fixed" type="fixed">
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6_gripper_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}link_6_gripper_base">
      <inertial>
        <origin xyz="0 -0.039307 0.000179" rpy="0 0 0"/>
        <mass value="0.033247"/>
        <inertia ixx="3.840939e-06" ixy="8.105131e-12" ixz="2.284531e-15" iyy="4.227427e-05" iyz="3.389360e-08" izz="3.969303e-05"/>
      </inertial>
      <visual>
        <origin xyz="-0.539369 -0.018286 -0.230423" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_6_gripper_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}dark_grey"/>
      </visual>
      <collision>
        <origin xyz="-0.539369 -0.018286 -0.230423" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_6_gripper_base.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Pinion Gear -->
    <joint name="${prefix}gripper_pinion_joint" type="revolute">
      <parent link="${prefix}link_6_gripper_base"/>
      <child link="${prefix}link_6_pinion_gear"/>
      <origin xyz="0 -0.03994 0.000013" rpy="0 0 0"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-3.14159" upper="3.14159" effort="5.0" velocity="3.14"/>
      <dynamics damping="0.01" friction="0.01"/>
    </joint>

    <link name="${prefix}link_6_pinion_gear">
      <inertial>
        <origin xyz="0 0.001971 0" rpy="0 0 0"/>
        <mass value="0.003489"/>
        <inertia ixx="8.533883e-08" ixy="1.151277e-17" ixz="-1.201101e-16" iyy="1.592699e-07" iyz="3.543629e-12" izz="8.533883e-08"/>
      </inertial>
      <visual>
        <origin xyz="-0.539369 0.021654 -0.230436" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_6_pinion_gear.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}metal_accent"/>
      </visual>
      <collision>
        <origin xyz="-0.539369 0.021654 -0.230436" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_6_pinion_gear.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Left Jaw (Mimic) -->
    <joint name="${prefix}left_jaw_slide_joint" type="prismatic">
      <parent link="${prefix}link_6_gripper_base"/>
      <child link="${prefix}link_6_left_jaw"/>
      <origin xyz="0 -0.046232 0.000013" rpy="0 0 0"/>
      <axis xyz="-1 0 0"/>
      <limit lower="0" upper="0.0255" effort="5.0" velocity="3.14"/>
      <mimic joint="${prefix}right_jaw_slide_joint" multiplier="1" offset="0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <link name="${prefix}link_6_left_jaw">
      <inertial>
        <origin xyz="-0.035366 -0.011466 -0.000664" rpy="0 0 0"/>
        <mass value="0.047804"/>
        <inertia ixx="9.783826e-06" ixy="8.298523e-07" ixz="3.005780e-07" iyy="6.167414e-06" iyz="5.917608e-07" izz="9.677005e-06"/>
      </inertial>
      <visual>
        <origin xyz="-0.513969 0.027946 -0.230436" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_6_left_jaw.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}black"/>
      </visual>
      <collision>
        <origin xyz="-0.513969 0.027946 -0.230436" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_6_left_jaw.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Right Jaw -->
    <joint name="${prefix}right_jaw_slide_joint" type="prismatic">
      <parent link="${prefix}link_6_gripper_base"/>
      <child link="${prefix}link_6_right_jaw"/>
      <origin xyz="0 -0.046232 0.000013" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0" upper="0.0255" effort="5.0" velocity="3.14"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>

    <link name="${prefix}link_6_right_jaw">
      <inertial>
        <origin xyz="0.035365 -0.011466 0.000659" rpy="0 0 0"/>
        <mass value="0.047804"/>
        <inertia ixx="9.784049e-06" ixy="-8.298810e-07" ixz="3.010660e-07" iyy="6.167753e-06" iyz="-5.901923e-07" izz="9.676889e-06"/>
      </inertial>
      <visual>
        <origin xyz="-0.564769 0.027946 -0.230436" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_6_right_jaw.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}black"/>
      </visual>
      <collision>
        <origin xyz="-0.564769 0.027946 -0.230436" rpy="0 0 0"/>
        <geometry>
          <mesh filename="${mesh_dir}/link_6_right_jaw.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- Optional Camera Mount -->
    <xacro:if value="${attach_cam_mount}">
      <joint name="${prefix}joint_5_to_cam_fixed" type="fixed">
        <parent link="${prefix}link_5"/>
        <child link="${prefix}cam_mount"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </joint>

      <link name="${prefix}cam_mount">
        <inertial>
          <origin xyz="0.0202512 -0.0681667 0.0554031" rpy="0 0 0"/>
          <mass value="0.0824984"/>
          <inertia ixx="2.872607e-05" ixy="-9.237056e-18" ixz="4.050094e-17" iyy="3.078672e-05" iyz="-4.956174e-06" izz="1.288844e-05"/>
        </inertial>
        <visual>
          <origin xyz="-0.539369 -0.018286 -0.230423" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${mesh_dir}/cam_mount.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="${prefix}dark_grey"/>
        </visual>
        <collision>
          <origin xyz="-0.539369 -0.018286 -0.230423" rpy="0 0 0"/>
          <geometry>
            <mesh filename="${mesh_dir}/cam_mount.stl" scale="0.001 0.001 0.001"/>
          </geometry>
        </collision>
      </link>
    </xacro:if>

  </xacro:macro>

  <!-- Default standalone instantiation -->
  <xacro:arg name="mesh_dir" default="package://nexarm_description/meshes/visual"/>
  <xacro:arg name="attach_cam_mount" default="true"/>

  <xacro:nexarm mesh_dir="$(arg mesh_dir)" attach_cam_mount="$(arg attach_cam_mount)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:nexarm>

</robot>
