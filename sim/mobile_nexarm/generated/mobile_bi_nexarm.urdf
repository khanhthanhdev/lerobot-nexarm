<?xml version='1.0' encoding='utf-8'?>
<robot name="mobile_bi_nexarm">
  <link name="world" />
  <link name="base_x_link" />
  <joint name="base_x" type="prismatic">
    <parent link="world" />
    <child link="base_x_link" />
    <axis xyz="1 0 0" />
    <limit lower="-10" upper="10" effort="1000" velocity="0.5" />
  </joint>
  <link name="base_y_link" />
  <joint name="base_y" type="prismatic">
    <parent link="base_x_link" />
    <child link="base_y_link" />
    <axis xyz="0 1 0" />
    <limit lower="-10" upper="10" effort="1000" velocity="0.5" />
  </joint>
  <link name="mobile_base" />
  <joint name="base_yaw" type="continuous">
    <parent link="base_y_link" />
    <child link="mobile_base" />
    <axis xyz="0 0 1" />
    <limit effort="1000" velocity="1.57079632679" />
  </joint>
  <link name="lift_carriage" />
  <joint name="lift_axis" type="prismatic">
    <parent link="mobile_base" />
    <child link="lift_carriage" />
    <axis xyz="0 0 1" />
    <limit lower="0.0" upper="0.35" effort="500" velocity="0.25" />
  </joint>
  <link name="left_arm_mount" />
  <joint name="left_arm_mount_joint" type="fixed">
    <parent link="lift_carriage" />
    <child link="left_arm_mount" />
    <origin xyz="0 0.22 0.27" rpy="0 0 -1.57079632679" />
  </joint>
  <link name="left_link_1" />
