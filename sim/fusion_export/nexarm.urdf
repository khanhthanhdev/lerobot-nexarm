    </collision>
  </link>

  <!-- Joint 1: Base to Link 1 (Shoulder Pan) -->
  <joint name="joint_1_base_to_link_1" type="revolute">
    <parent link="base_link" />
    <child link="link_1" />
    <origin xyz="0 0 0.049" rpy="0 0 0" />
    <axis xyz="0 0 -1" />
    <limit lower="-2.35619" upper="2.35619" effort="5.0" velocity="3.14" />
  </joint>

  <!-- Link 1 -->
  <link name="link_1">
