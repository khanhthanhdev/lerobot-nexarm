  <!-- Link 2 -->
  <link name="link_2">
    <inertial>
      <origin xyz="-0.03428 0.0804481 0.0817056" rpy="0 0 0" />
      <mass value="0.49949" />
      <inertia ixx="2.232805e-03" ixy="-6.385181e-12" ixz="-7.231483e-12" iyy="1.283494e-03" iyz="-1.079517e-03" izz="1.184026e-03" />
