<?xml version='1.0' encoding='utf-8'?>
<robot name="nexarm">
  <material name="dark_grey">
    <color rgba="0.2 0.2 0.2 1.0" />
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0" />
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <origin xyz="1.15052e-05 -0.000135185 0.0185734" rpy="0 0 0" />
      <mass value="0.786653" />
      <inertia ixx="1.397924e-03" ixy="-4.416572e-07" ixz="-1.795833e-09" iyy="1.440493e-03" iyz="-1.189059e-05" izz="1.872355e-03" />
    </inertial>
    <visual>
      <origin xyz="-0.539369 -0.0639728 0" rpy="0 0 0" />
