    <child link="link_6_left_jaw" />
    <origin xyz="0 -0.046232 0.000013" rpy="0 0 0" />
    <axis xyz="-1 0 0" />
    <limit lower="0" upper="0.0255" effort="5.0" velocity="3.14" />
    <mimic joint="right_jaw_slide_joint" multiplier="-1" offset="0" />
