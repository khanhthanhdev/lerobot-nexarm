          "id",
          "kind",
          "profile",
          "state",
          "started_at"
        ],
        "title": "SessionInfo",
        "type": "object"
      },
      "SessionKind": {
        "enum": [
          "teleoperation",
          "recording",
          "replay",
          "rollout",
          "eval",
          "coaching",
          "hosting",
          "remote_teleoperation"
        ],
        "title": "SessionKind",
        "type": "string"
      },
      "SessionState": {
        "enum": [
          "starting",
          "running",
          "stopping",
          "stopped",
          "failed"
        ],
        "title": "SessionState",
        "type": "string"
      },
      "StartSession": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/SessionKind"
          },
          "params": {
            "additionalProperties": true,
            "default": {},
            "title": "Params",
            "type": "object"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "profile"
        ],
        "title": "StartSession",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
