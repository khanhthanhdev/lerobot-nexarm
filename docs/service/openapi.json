          "baudrate": {
            "default": 1000000,
            "exclusiveMinimum": 0.0,
            "title": "Baudrate",
            "type": "integer"
          },
          "cameras": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CameraProfile"
            },
            "title": "Cameras",
            "type": "object"
          },
          "follower_port": {
            "title": "Follower Port",
            "type": "string"
          },
          "leader_port": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Leader Port"
          },
          "name": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "follower_port"
        ],
        "title": "RobotProfile",
        "type": "object"
      },
      "SessionInfo": {
        "properties": {
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/SessionKind"
          },
          "profile": {
            "title": "Profile",
            "type": "string"
          },
          "started_at": {
            "title": "Started At",
            "type": "number"
          },
          "state": {
            "$ref": "#/components/schemas/SessionState"
          },
