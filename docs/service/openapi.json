  "info": {
    "description": "Local engine for the NexArm desktop app.",
    "title": "NexArm engine",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/calibration/check": {
      "post": {
        "description": "Write identity calibration files and report leader/follower deltas at the vendor Home pose.\n\nBoth arms must be placed at Home by hand first; this only reads positions and never energises\nthe follower.",
        "operationId": "calibration_check_api_v1_calibration_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalibrationCheck"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalibrationReport"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Calibration Check",
        "tags": [
          "calibration"
        ]
      }
    },
