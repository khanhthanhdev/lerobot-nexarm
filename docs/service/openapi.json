{
  "components": {
    "schemas": {
      "CalibrationCheck": {
        "properties": {
          "profile": {
            "title": "Profile",
            "type": "string"
          }
        },
        "required": [
          "profile"
        ],
        "title": "CalibrationCheck",
        "type": "object"
      },
      "CalibrationReport": {
        "properties": {
          "hint": {
            "title": "Hint",
            "type": "string"
          },
          "joints": {
            "items": {
              "$ref": "#/components/schemas/JointDelta"
            },
            "title": "Joints",
            "type": "array"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "reset_files": {
            "items": {
              "type": "string"
            },
            "title": "Reset Files",
            "type": "array"
          },
          "tolerance_ticks": {
            "title": "Tolerance Ticks",
            "type": "integer"
          }
        },
        "required": [
          "tolerance_ticks",
          "joints",
          "ok",
          "reset_files",
          "hint"
        ],
        "title": "CalibrationReport",
        "type": "object"
      },
      "CameraProfile": {
        "properties": {
          "fps": {
            "default": 30,
            "exclusiveMinimum": 0.0,
            "title": "Fps",
            "type": "integer"
          },
          "height": {
            "default": 480,
            "exclusiveMinimum": 0.0,
            "title": "Height",
            "type": "integer"
          },
          "source": {
            "title": "Source",
            "type": "string"
          },
          "type": {
            "const": "opencv",
            "default": "opencv",
            "title": "Type",
            "type": "string"
          },
          "width": {
            "default": 640,
            "exclusiveMinimum": 0.0,
            "title": "Width",
            "type": "integer"
          }
        },
        "required": [
          "source"
        ],
        "title": "CameraProfile",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "api_version": {
            "title": "Api Version",
            "type": "string"
          },
          "capabilities": {
            "items": {
              "type": "string"
            },
            "title": "Capabilities",
            "type": "array"
          },
          "pid": {
            "title": "Pid",
            "type": "integer"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "api_version",
          "capabilities",
          "pid"
        ],
        "title": "Health",
        "type": "object"
      },
      "JointDelta": {
        "properties": {
          "delta": {
            "title": "Delta",
            "type": "integer"
          },
          "follower": {
            "title": "Follower",
            "type": "integer"
          },
          "joint": {
            "title": "Joint",
            "type": "string"
          },
          "leader_mapped": {
            "title": "Leader Mapped",
            "type": "integer"
          },
          "leader_raw": {
            "title": "Leader Raw",
            "type": "integer"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          }
        },
        "required": [
